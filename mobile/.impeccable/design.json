      "css": ".ds-field-label{display:block;margin-bottom:4px;color:rgba(28,27,31,1);font:400 12px/16px sans-serif}.ds-field{display:block;width:calc(100% - 34px);min-height:54px;padding:0 16px;border:1px solid rgba(121,116,126,1);border-radius:4px;background:#ffffff;color:rgba(28,27,31,1);font:400 16px/24px sans-serif;letter-spacing:.15px}.ds-field:hover{border-color:rgba(28,27,31,1)}.ds-field:focus{border-color:#384bc2}.ds-primary:focus-visible,.ds-outlined:focus-visible,.ds-field:focus-visible,.ds-nav button:focus-visible,.ds-chip:focus-visible{outline:3px solid #384bc2;outline-offset:3px}"
    },
