      "css": ".ds-outlined{min-height:48px;padding:9px 23px;border:1px solid rgba(121,116,126,1);border-radius:20px;background:transparent;color:#384bc2;font:500 14px/20px sans-serif;letter-spacing:.1px;cursor:pointer}.ds-outlined:hover{background:#384bc214}.ds-outlined:active{background:#384bc21f}.ds-outlined:disabled{opacity:.38;cursor:default}.ds-primary:focus-visible,.ds-outlined:focus-visible,.ds-field:focus-visible,.ds-nav button:focus-visible,.ds-chip:focus-visible{outline:3px solid #384bc2;outline-offset:3px}"
