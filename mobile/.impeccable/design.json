    {
      "name": "Contained Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Browser reference for the native 48dp minimum contained action; native ripple is not reproduced.",
      "html": "<button class=\"ds-primary\">Make my mini quiz</button>",
      "css": ".ds-primary{min-height:48px;padding:10px 24px;border:0;border-radius:20px;background:#384bc2;color:#ffffff;font:500 14px/20px sans-serif;letter-spacing:.1px;cursor:pointer}.ds-primary:hover{background:color-mix(in srgb,#384bc2 92%,#ffffff)}.ds-primary:active{background:color-mix(in srgb,#384bc2 88%,#ffffff)}.ds-primary:disabled{opacity:.38;cursor:default}.ds-primary:focus-visible,.ds-outlined:focus-visible,.ds-field:focus-visible,.ds-nav button:focus-visible,.ds-chip:focus-visible{outline:3px solid #384bc2;outline-offset:3px}"
    },
